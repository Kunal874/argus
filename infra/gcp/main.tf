terraform { required_version = ">= 1.8"; required_providers { google = { source = "hashicorp/google" version = "~> 6.0" } random = { source = "hashicorp/random" version = "~> 3.6" } } }
provider "google" { project = var.project_id region = var.region }
locals { name = "argus-${var.environment}" }
resource "google_project_service" "services" { for_each = toset(["run.googleapis.com","sqladmin.googleapis.com","storage.googleapis.com","pubsub.googleapis.com","cloudtasks.googleapis.com","secretmanager.googleapis.com","cloudkms.googleapis.com","servicenetworking.googleapis.com"]) service = each.value disable_on_destroy = false }
resource "google_compute_network" "main" { name = local.name auto_create_subnetworks = false }
resource "google_compute_subnetwork" "main" { name = local.name region = var.region network = google_compute_network.main.id ip_cidr_range = "10.20.0.0/20" private_ip_google_access = true }
resource "google_compute_global_address" "private" { name = "${local.name}-sql" purpose = "VPC_PEERING" address_type = "INTERNAL" prefix_length = 16 network = google_compute_network.main.id }
resource "google_service_networking_connection" "private" { network = google_compute_network.main.id service = "servicenetworking.googleapis.com" reserved_peering_ranges = [google_compute_global_address.private.name] }
resource "random_password" "db" { length = 32 special = true }
resource "google_sql_database_instance" "postgres" { name = local.name region = var.region database_version = "POSTGRES_16" depends_on = [google_service_networking_connection.private] deletion_protection = true settings { tier = "db-custom-2-7680" availability_type = "REGIONAL" disk_autoresize = true backup_configuration { enabled = true point_in_time_recovery_enabled = true transaction_log_retention_days = 7 backup_retention_settings { retained_backups = 35 retention_unit = "COUNT" } } ip_configuration { ipv4_enabled = false private_network = google_compute_network.main.id require_ssl = true } } }
resource "google_sql_database" "argus" { name = "argus" instance = google_sql_database_instance.postgres.name }
resource "google_sql_user" "api" { name = "argus_api" instance = google_sql_database_instance.postgres.name password = random_password.db.result }
resource "google_storage_bucket" "data" { name = "${var.project_id}-${local.name}-data" location = "ASIA-SOUTH1" uniform_bucket_level_access = true public_access_prevention = "enforced" versioning { enabled = true } lifecycle_rule { condition { age = 30 matches_prefix = ["raw/","quarantine/"] } action { type = "Delete" } } }
resource "google_pubsub_topic" "analysis" { name = "${local.name}-analysis" message_retention_duration = "604800s" }
resource "google_pubsub_subscription" "analysis" { name = "${local.name}-analysis-worker" topic = google_pubsub_topic.analysis.id ack_deadline_seconds = 600 dead_letter_policy { dead_letter_topic = google_pubsub_topic.dead_letter.id max_delivery_attempts = 5 } }
resource "google_pubsub_topic" "dead_letter" { name = "${local.name}-dead-letter" }
resource "google_service_account" "api" { account_id = "${local.name}-api" display_name = "Argus API" }
resource "google_service_account" "model" { account_id = "${local.name}-model" display_name = "Argus model jobs" }
resource "google_cloud_run_v2_service" "api" { name = "${local.name}-api" location = var.region ingress = "INGRESS_TRAFFIC_INTERNAL_LOAD_BALANCER" template { service_account = google_service_account.api.email timeout = "300s" scaling { min_instance_count = 1 max_instance_count = 100 } containers { image = var.api_image resources { limits = { cpu = "2" memory = "2Gi" } } env { name = "GCP_REGION" value = var.region } volume_mounts { name = "cloudsql" mount_path = "/cloudsql" } } volumes { name = "cloudsql" cloud_sql_instance { instances = [google_sql_database_instance.postgres.connection_name] } } vpc_access { network_interfaces { network = google_compute_network.main.name subnetwork = google_compute_subnetwork.main.name } egress = "PRIVATE_RANGES_ONLY" } } }
resource "google_cloud_run_v2_job" "model" { name = "${local.name}-model" location = var.region template { template { service_account = google_service_account.model.email timeout = "3600s" containers { image = var.model_image resources { limits = { cpu = "4" memory = "8Gi" } } } vpc_access { network_interfaces { network = google_compute_network.main.name subnetwork = google_compute_subnetwork.main.name } egress = "PRIVATE_RANGES_ONLY" } } } }
